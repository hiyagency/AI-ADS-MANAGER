# Browser-safe Supabase project settings only. Never add a secret/service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only Netlify values. Never prefix these with VITE_ or expose them to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-server-secret-key
PUBLIC_APP_URL=https://ads.hiy.agency

# Meta agency system-user configuration. The API version is explicit so upgrades are deliberate.
META_GRAPH_API_VERSION=vXX.X
META_ACCESS_TOKEN=your-server-only-meta-system-user-token
META_APP_ACCESS_TOKEN=your-server-only-meta-app-access-token

# Phase 6 reporting controls. Supported attribution windows are validated at runtime.
META_ATTRIBUTION_WINDOWS=7d_click,1d_view
META_SYNC_LOOKBACK_DAYS=35
META_SYNC_ENABLED=false

# Generate a long random value independently for production.
SYNC_DISPATCH_SECRET=your-long-random-internal-dispatch-secret
